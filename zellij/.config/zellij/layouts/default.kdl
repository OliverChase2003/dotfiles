layout {
	pane
	pane size=1 borderless=true {
		plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
			format_left			"{tabs}"
			format_center		""
			format_right		"#[fg=#cdd6f4,bold] {session} {mode}"
			format_space		"[#363a4f] "

			mode_normal			"#[bg=#b4befe,fg=#1e1e2e,bold] NORMAL  "
			mode_tmux			"#[bg=#cba6f7,fg=#1e1e2e,bold]  TMUX   "
			mode_move			"#[bg=#eba0ac,fg=#1e1e2e,bold]  MOVE   "
			mode_tab			"#[bg=#89b4fa,fg=#1e1e2e,bold] WINDOW  "
			mode_pane			"#[bg=#a6e3a1,fg=#1e1e2e,bold]  PANE   "
			mode_locked			"#[bg=#f38ba8,fg=#1e1e2e,bold] LOCKED  "
			mode_scroll			"#[bg=#89b4fa,fg=#1e1e2e,bold] VISUAL  "
			mode_search			"#[bg=#89b4fa,fg=#1e1e2e,bold] SEARCH  "
			mode_enter_search	"#[bg=#f38ba8,fg=#1e1e2e,bold] SEARCH  "
			mode_rename_tab		"#[bg=#89b4fa,fg=#1e1e2e,bold] RENAME  "
			mode_rename_pane	"#[bg=#a6e3a1,fg=#1e1e2e,bold] RENAME  "

			tab_normal		"#[bg=#876FA5,fg=#313244] {index} #[bg=#1E1E2E,fg=#A5ADCB] {name} "
			tab_active		"#[bg=#CBA6F7,fg=#313244,bold] {index} #[bg=#1E1E2E,fg=#CDD6F4,bold] {name} "
		}
	}
}
