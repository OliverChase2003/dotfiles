{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "plan",
	"permission": {
		"bash": "allow",
		"edit": "ask",
		"read": "allow",
		"grep": "allow",
		"glob": "allow",
		"list": "allow",
		"lsp": "allow",
		"skill": "allow",
		"todowrite": "allow",
		"webfetch": "allow",
		"websearch": "allow",
		"question": "allow",
		"codesearch": "allow",
		"external_directory": "allow",
		"task": "allow",
		"doom_loop": "ask"
	},
	"autoupdate": false,
	"watcher": {
		"ignore": ["node_modules/**", "dist/**", ".git/**"]
	}
}

